{erl_opts, [debug_info]}.
%% The Hex cowboy 2.13.0 metadata contains an unsupported dependency-version
%% expression for rebar3 3.25.1. Track the same upstream released Git tree
%% (commit behind tag 2.13.0), whose rebar.config pins cowlib and ranch by tag.
{deps, [
    {cowboy, {git, "https://github.com/ninenines/cowboy.git",
        {ref, "24d32de931a0c985ff7939077463fc8be939f0e9"}}}
]}.
